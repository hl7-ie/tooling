{
  "resourceType": "CapabilityStatement",
  "id": "ie-tooling-server",
  "url": "https://hl7-ie.github.io/tooling/fhir/CapabilityStatement/ie-tooling-server",
  "version": "0.1.0",
  "name": "IEToolingServer",
  "title": "HL7 Ireland Tooling – Reference Server Capability Statement",
  "status": "draft",
  "experimental": true,
  "date": "2024-01-01",
  "publisher": "HL7 Ireland",
  "contact": [
    {
      "name": "HL7 Ireland",
      "telecom": [
        {
          "system": "url",
          "value": "https://hl7-ie.github.io"
        },
        {
          "system": "email",
          "value": "fhir@hl7.ie"
        }
      ]
    }
  ],
  "description": "Baseline FHIR R4 server capability declaration for HL7 Ireland compliant FHIR servers.",
  "jurisdiction": [
    {
      "coding": [
        {
          "system": "urn:iso:std:iso:3166",
          "code": "IE",
          "display": "Ireland"
        }
      ]
    }
  ],
  "kind": "requirements",
  "fhirVersion": "4.0.1",
  "format": ["json", "xml"],
  "rest": [
    {
      "mode": "server",
      "documentation": "HL7 Ireland baseline FHIR R4 server.",
      "security": {
        "cors": true,
        "service": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/restful-security-service",
                "code": "SMART-on-FHIR"
              }
            ]
          }
        ],
        "description": "SMART on FHIR OAuth2 authorisation."
      },
      "resource": [
        {
          "type": "Patient",
          "profile": "https://hl7-ie.github.io/tooling/fhir/StructureDefinition/ie-patient",
          "interaction": [
            { "code": "read" },
            { "code": "search-type" },
            { "code": "create" },
            { "code": "update" }
          ],
          "searchParam": [
            {
              "name": "identifier",
              "type": "token",
              "documentation": "Search by PPSN or other national identifier."
            },
            {
              "name": "family",
              "type": "string"
            },
            {
              "name": "birthdate",
              "type": "date"
            }
          ]
        },
        {
          "type": "Encounter",
          "interaction": [
            { "code": "read" },
            { "code": "search-type" },
            { "code": "create" }
          ],
          "searchParam": [
            {
              "name": "patient",
              "type": "reference"
            },
            {
              "name": "date",
              "type": "date"
            }
          ]
        },
        {
          "type": "MedicationRequest",
          "interaction": [
            { "code": "read" },
            { "code": "search-type" },
            { "code": "create" }
          ],
          "searchParam": [
            {
              "name": "patient",
              "type": "reference"
            },
            {
              "name": "status",
              "type": "token"
            }
          ]
        },
        {
          "type": "Observation",
          "interaction": [
            { "code": "read" },
            { "code": "search-type" },
            { "code": "create" }
          ],
          "searchParam": [
            {
              "name": "patient",
              "type": "reference"
            },
            {
              "name": "code",
              "type": "token"
            },
            {
              "name": "date",
              "type": "date"
            }
          ]
        }
      ]
    }
  ]
}
